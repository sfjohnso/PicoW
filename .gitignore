!Documents/Projects/DM42/Ackermann/bin/check_qspi_crc
!Documents/Projects/DM42/Ackermann/dmcp/
!Documents/Projects/DM42/Ackermann/dmcp/*.h
!Documents/Projects/DM42/Ackermann/dmcp/startup_pgm.s
!Documents/Projects/DM42/Ackermann/dmcp/sys/
!Documents/Projects/DM42/Ackermann/dmcp/sys/*.c
